@using Microsoft.AspNetCore.Http
@{
    var fullName = User.Identity?.Name ?? "Admin";
    var initials = string.Join("", fullName.Split(" ").Select(n => n[0])).ToUpper();

    var message = TempData["StatusMessage"] as string;
    var type = TempData["StatusMessageType"] as string ?? "info";

}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UniPortal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="~/lib/bootstrap/dist/icon/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/lib/select2/select2.min.css" rel="stylesheet" />
</head>
<body class="bg-light">

    <!-- Admin Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-page="/dashboards/admin">
                <img src="~/favicon.ico" alt="UniPortal Logo" width="30" height="30" class="me-2" />
                UniPortal
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavbar"
                    aria-controls="adminNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            @using UniPortal.Constants

            <div class="collapse navbar-collapse" id="adminNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                    <!-- Core Academic Setup -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="coreAcademicDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Academic Setup
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="coreAcademicDropdown">
                            <li><a class="dropdown-item" asp-page="/academics/configs/institution">University</a></li>
                            <li><a class="dropdown-item" asp-page="/academics/configs/department">Departments</a></li>
                            <li><a class="dropdown-item" asp-page="/academics/configs/degree">Degrees</a></li>
                            <li><a class="dropdown-item" asp-page="/academics/configs/program">Programs</a></li>
                            <li><a class="dropdown-item" asp-page="/academics/configs/semester">Semesters</a></li>
                        </ul>
                    </li>

                    <!-- Courses & Grading -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="coursesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Courses & Grading
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="coursesDropdown">
                            <li><a class="dropdown-item" asp-page="/academics/configs/gradescale">Grade Scales</a></li>
                            <li><a class="dropdown-item" asp-page="/academics/configs/coursetype">Course Types</a></li>
                            <li><a class="dropdown-item" asp-page="/academics/configs/course">Courses</a></li>
                            <li><a class="dropdown-item" asp-page="/academics/configs/curriculum">Curriculums</a></li>
                        </ul>
                    </li>

                    <!-- Class Organization -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="classOrgDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Class Organization
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="classOrgDropdown">
                            <li><a class="dropdown-item" asp-page="/academics/configs/room">Rooms</a></li>
                            <li><a class="dropdown-item" asp-page="/academics/configs/batch">Batches</a></li>
                            <li><a class="dropdown-item" asp-page="/academics/configs/section">Sections</a></li>
                        </ul>
                    </li>

                    <!-- Notices & Recipients -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="noticeDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Notifications
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="noticeDropdown">
                            <li><a class="dropdown-item" asp-page="/academics/configs/recipient">Recipients</a></li>
                            <li><a class="dropdown-item" asp-page="/academics/operations/notification">Notifications</a></li>
                        </ul>
                    </li>

                    <!-- User Management -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Users
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="userDropdown">
                            @if (User.IsInRole(Roles.Root))
                            {
                                <li><a class="dropdown-item" asp-page="/users/admin">Admins</a></li>
                            }
                            <li><a class="dropdown-item" asp-page="/academics/configs/facultytype">Faculty Types</a></li>
                            <li><a class="dropdown-item" asp-page="/users/faculty">Faculties</a></li>
                            <li><a class="dropdown-item" asp-page="/users/student">Students</a></li>
                        </ul>
                    </li>

                </ul>

                <div class="d-flex align-items-center ms-auto">
                    <span class="me-3">Welcome, <strong>@fullName</strong></span>

                    @if (User.IsInRole(Roles.Root))
                    {
                        <span class="badge me-3" style="background-color:#000000; color:white;">Root</span>
                    }
                    else
                    {
                        <span class="badge bg-danger me-3">Admin</span>
                    }

                    <form method="post" asp-page="/Accounts/Logout">
                        <button type="submit" class="btn btn-outline-danger btn-sm">Logout</button>
                    </form>
                </div>
            </div>



        </div>
    </nav>


    <!-- Reusable Delete Confirmation Modal -->
    <div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmDeleteModalLabel">Confirm Delete</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete this item?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form id="deleteForm" method="post">
                        <input type="hidden" name="id" id="deleteItemId" />
                        <button type="submit" class="btn btn-danger">Yes, Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        function showDeleteModal(itemId, actionUrl) {
            document.getElementById('deleteItemId').value = itemId;
            document.getElementById('deleteForm').action = actionUrl;
            var deleteModal = new bootstrap.Modal(document.getElementById('confirmDeleteModal'));
            deleteModal.show();
        }
    </script>



    <!-- Main Content -->
    <div class="container px-4 pb-5">

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert alert-@type alert-dismissible fade show" role="alert">
                @message
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <!-- Optional Footer -->
    <footer class="footer mt-auto py-3 bg-light fixed-bottom border-top">
        <div class="container text-center text-muted">
            &copy; 2025 UniPortal
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/select2/select2.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
