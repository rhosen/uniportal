@page
@model UniPortal.Pages.Academics.EnrollmentModel
@{
    ViewData["Title"] = "Enrollment Management";
    Layout = "_FacultyLayout";
}

<div class="container my-4">
    <h2 class="mb-4">🎓 Enrollment Management</h2>

    <!-- Current Semester -->
    <div class="mb-3">
        <strong>Current Semester:</strong> @Model.CurrentSemester.Name (@Model.CurrentSemester.StartDate.ToString("MMM yyyy") – @Model.CurrentSemester.EndDate.ToString("MMM yyyy"))
    </div>

    <!-- Search Box -->
    <form method="get" class="mb-3">
        <div class="input-group">
            <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by student name or ID..." />
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
    </form>

    <!-- Add New Enrollment -->
    <form method="post">
        <table class="table table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Student</th>
                    <th>Course</th>
                    <th>Department</th>
                    <th>Teacher</th>
                    <th>Credits</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <select asp-for="NewEnrollment.StudentId" asp-items="Model.StudentSelectList" class="form-select">
                            <option value="">Select Student</option>
                        </select>
                    </td>
                    <td>
                        <select asp-for="NewEnrollment.CourseId" asp-items="Model.CourseSelectList" class="form-select" onchange="updateCourseDetails()">
                            <option value="">Select Course</option>
                        </select>
                    </td>
                    <td><input id="department" class="form-control" readonly /></td>
                    <td><input id="teacher" class="form-control" readonly /></td>
                    <td><input id="credits" class="form-control" readonly /></td>
                    <td><button type="submit" asp-page-handler="Create" class="btn btn-success">Enroll</button></td>
                </tr>
            </tbody>
        </table>
    </form>

    <!-- Existing Enrollments Table -->
    <table class="table table-striped">
        <thead class="table-dark">
            <tr>
                <th>Student ID</th>
                <th>Student Name</th>
                <th>Department</th>
                <th>Course</th>
                <th>Teacher</th>
                <th>Credits</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var enrollment in Model.Enrollments)
            {
                <tr>
                    <td>@enrollment.StudentId</td>
                    <td>@enrollment.StudentName</td>
                    <td>@enrollment.Department</td>
                    <td>@enrollment.CourseName</td>
                    <td>@enrollment.TeacherName</td>
                    <td>@enrollment.Credits</td>
                    <td>
                        @if (!enrollment.IsDeleted)
                        {
                            <button type="submit" class="btn btn-sm btn-danger" onclick="showDeleteModal('@enrollment.Id', '@Url.Page("", "", new { handler = "Delete" }, null)')">Delete</button>
                        }
                        else
                        {
                            <button type="submit" asp-page-handler="Activate" name="id" value="@enrollment.Id" class="btn btn-sm btn-success">Activate</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Pagination -->
    <nav>
        <ul class="pagination">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="?CurrentPage=@(Model.CurrentPage - 1)&SearchTerm=@Model.SearchTerm">Previous</a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="?CurrentPage=@i&SearchTerm=@Model.SearchTerm">@i</a>
                </li>
            }
            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="?CurrentPage=@(Model.CurrentPage + 1)&SearchTerm=@Model.SearchTerm">Next</a>
            </li>
        </ul>
    </nav>
</div>

<script>
    const courses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CourseDetails));

    function updateCourseDetails() {
        const courseId = document.querySelector('select[name="NewEnrollment.CourseId"]').value;
        const course = courses.find(c => c.Id === courseId);
        if (course) {
            document.getElementById('department').value = course.DepartmentName;
            document.getElementById('teacher').value = course.TeacherName;
            document.getElementById('credits').value = course.Credits;
        } else {
            document.getElementById('department').value = '';
            document.getElementById('teacher').value = '';
            document.getElementById('credits').value = '';
        }
    }
</script>
