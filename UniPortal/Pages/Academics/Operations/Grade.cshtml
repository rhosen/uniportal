@page
@model UniPortal.Pages.Academics.Operations.GradeModel
@{
    ViewData["Title"] = "Teacher Grades";
    Layout = "_FacultyLayout";
}

<div class="container my-4">

    <!-- Page Header -->
    <div class="d-flex align-items-center mb-4">
        <svg class="me-2 text-primary" width="40" height="40" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-1 14H6v-2h12v2zm0-4H6v-2h12v2zm0-4H6V7h12v2z" />
        </svg>
        <div>
            <h5 class="mb-0 fw-bold">Manage Grades</h5>
        </div>
    </div>

    <div class="row g-4">

        <!-- Left Panel: Student & Semester Selector -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 p-3" style="background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%);">

                <!-- Semester & Student Selection -->
                <form method="get" class="mb-3">
                    <div class="mb-3">
                        <select asp-for="SelectedSemesterNumber" class="form-select mb-2"
                                asp-items="@(new SelectList(Model.SemesterNumberOptions, "Number", "Name", Model.SelectedSemesterNumber))"
                                required onchange="this.form.submit()">
                            <option value="">-- Select Semester --</option>
                        </select>

                        <select name="SelectedStudentId" class="form-select" @(Model.SelectedSemesterNumber <= 0 ? "disabled" : "") onchange="this.form.submit()">
                            <option value="">-- Select Student --</option>
                            @foreach (var student in Model.Students)
                            {
                                <option value="@student.Id" selected="@(student.Id == Model.SelectedStudentId ? "selected" : null)">
                                    @student.Name
                                </option>
                            }
                        </select>
                    </div>
                </form>

                @if (Model.SelectedStudentId != Guid.Empty)
                {
                    var selectedStudent = Model.Students.FirstOrDefault(s => s.Id == Model.SelectedStudentId);
                    if (selectedStudent != null)
                    {
                        <div class="mt-3">
                            <div class="d-flex align-items-center mb-2">
                                <!-- Student Icon -->
                                <svg class="me-2 text-primary" width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 12c2.7 0 5-2.3 5-5s-2.3-5-5-5-5 2.3-5 5 2.3 5 5 5zm0 2c-3.3 0-10 1.7-10 5v3h20v-3c0-3.3-6.7-5-10-5z" />
                                </svg>
                                <span class="fw-semibold">@selectedStudent.Name</span>
                            </div>

                            <div class="d-flex align-items-center mb-2">
                                <!-- Semester Icon -->
                                <svg class="me-2 text-info" width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 18H5V9h14v13z" />
                                </svg>
                                <span class="fw-semibold">Semester: @Model.SelectedSemesterNumber</span>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Right Panel: Grades Table -->
        <div class="col-md-9">
            @if (Model.SelectedSemesterNumber > 0 && Model.SelectedStudentId != Guid.Empty)
            {
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white d-flex align-items-center">
                        <!-- Grades Table Icon -->
                        <svg class="me-2 text-success" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M3 3h18v2H3V3zm0 4h18v2H3V7zm0 4h12v2H3v-2zm0 4h12v2H3v-2zm0 4h12v2H3v-2z" />
                        </svg>
                        <h5 class="mb-0">Grades</h5>
                    </div>
                    <div class="card-body p-0">

                        <table class="table table-hover table-striped mb-0 align-middle">
                            <thead class="table-light text-muted">
                                <tr>
                                    <th>Course</th>
                                    <th>Grade</th>
                                    <th>Marks</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var grade in Model.Grades)
                                {
                                    <tr>
                                        <form method="post">
                                            <input type="hidden" asp-for="SelectedStudentId" />
                                            <input type="hidden" asp-for="SelectedSemesterNumber" />
                                            <input type="hidden" name="CourseOfferingId" value="@grade.CourseOfferingId" />

                                        <td>@grade.CourseCode - @grade.CourseTitle</td>
                                        <td><input name="Grade" value="@grade.Grade" class="form-control" readonly /></td>
                                        <td><input name="Marks" type="number" step="0.01" value="@grade.Marks" class="form-control" /></td>
                                        <td>
                                            <button type="submit" asp-page-handler="Save" class="btn btn-success btn-sm">Save</button>
                                        </td>
                                        </form>
                                    </tr>
                                }
                            </tbody>
                        </table>

                    </div>
                </div>
            }
            else
            {
                <!-- Placeholder when no student or semester is selected -->
                <div class="card shadow-sm border-0 p-5 text-center text-muted">
                    <!-- Info Icon -->
                    <svg class="mb-3" width="48" height="48" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm1 15h-2v-6h2zm0-8h-2V7h2z" />
                    </svg>
                    <h5>No student or semester selected</h5>
                    <p>Select a student and semester from the left panel to view grades.</p>
                </div>
            }
        </div>

    </div>
</div>
