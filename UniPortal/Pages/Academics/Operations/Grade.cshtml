@page
@model UniPortal.Pages.Academics.Operations.GradeModel
@{
    ViewData["Title"] = "Teacher Grades";
    Layout = "_FacultyLayout";
}

<div class="container my-4">
    <h2 class="mb-4">📊 Manage Grades</h2>

    <!-- Semester & Student Selector -->
    <form method="get" class="mb-3">
        <div class="input-group w-50">
            <!-- Semester -->
            <select asp-for="SelectedSemesterNumber" class="form-select"
                    asp-items="@(new SelectList(Model.Semesters, "Id", "Name", Model.SelectedSemesterNumber))"
                    required onchange="this.form.submit()">
                <option value="">-- Select Semester --</option>
            </select>

            <!-- Student -->
            <select class="form-select" @(Model.SelectedSemesterNumber <= 0 ? "disabled" : "") onchange="this.form.submit()">
                <option value="">-- Select Student --</option>
                @foreach (var student in Model.Students)
                {
                    <option value="@student.Id" selected="@(student.Id == Model.SelectedStudentId ? "selected" : null)">
                        @student.Name
                    </option>
                }
            </select>

            <input type="text" name="SearchTerm" value="@Model.SearchTerm"
                   class="form-control" placeholder="Search by subject..." />
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
    </form>

    @if (Model.SelectedSemesterNumber > 0 && Model.SelectedStudentId != Guid.Empty)
    {
        <!-- Editable Grades Grid -->
        <table class="table table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Course / Subject</th>
                    <th>Grade</th>
                    <th>Marks</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var grade in Model.Grades)
                {
                    <tr>
                        <form method="post">
                            <input type="hidden" asp-for="SelectedStudentId" />
                            <input type="hidden" asp-for="SelectedSemesterNumber" />
                            <input type="hidden" name="CourseId" value="@grade.CourseId" />

                            <td>@grade.SubjectCode - @grade.SubjectName</td>
                            <td><input name="Grade" value="@grade.Grade" class="form-control" readonly/></td>
                            <td><input name="Marks" type="number" step="0.01" value="@grade.Marks" class="form-control" /></td>
                            <td><button type="submit" asp-page-handler="Save" class="btn btn-success btn-sm">Save</button></td>
                        </form>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Pagination -->
        <nav>
            <ul class="pagination">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="?CurrentPage=@(Model.CurrentPage - 1)&SelectedSemesterNumber=@Model.SelectedSemesterNumber&SelectedStudentId=@Model.SelectedStudentId&SearchTerm=@Model.SearchTerm">Previous</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="?CurrentPage=@i&SelectedSemesterNumber=@Model.SelectedSemesterNumber&SelectedStudentId=@Model.SelectedStudentId&SearchTerm=@Model.SearchTerm">@i</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="?CurrentPage=@(Model.CurrentPage + 1)&SelectedSemesterNumber=@Model.SelectedSemesterNumber&SelectedStudentId=@Model.SelectedStudentId&SearchTerm=@Model.SearchTerm">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>
