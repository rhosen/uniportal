@page
@model UniPortal.Pages.Academics.Operations.NotificationModel
@{
    ViewData["Title"] = "Notification Management";
    Layout = "_AdminLayout";
}

<div class="container my-4">
    <h2 class="mb-4">🔔 Notifications Management</h2>

    <!-- Search Box -->
    <form method="get" class="mb-3">
        <div class="input-group">
            <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by title..." />
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
    </form>

    <!-- Add New Notification -->
    <form method="post" enctype="multipart/form-data">
        <table class="table table-striped">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Title</th>
                    <th>Message</th>
                    <th>Recipient Type</th>
                    <th>Recipient Number</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>New</td>
                    <td><input asp-for="NewNotification.Title" class="form-control" required /></td>
                    <td>
                        <textarea rows="1" asp-for="NewNotification.Message" class="form-control" required></textarea>
                        <input type="file" asp-for="NewNotificationFile" class="form-control mt-1" />
                    </td>
                    <td>
                        <select asp-for="NewNotification.RecipientTypeId" class="form-select" required>
                            <option value="">-- Select Type --</option>
                            @foreach (var type in Model.RecipientTypes)
                            {
                                <option value="@type.Id">@type.Name</option>
                            }
                        </select>
                    </td>
                    <td>
                        <input asp-for="NewNotification.RecipientNumber" class="form-control" placeholder="Student or Faculty Number" />
                    </td>
                    <td>
                        <button type="submit" asp-page-handler="Create" class="btn btn-success btn-sm">Add</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>

    <!-- Existing Notifications Table -->
    <table class="table table-striped">
        <thead class="table-dark">
            <tr>
                <th>Title</th>
                <th>Message</th>
                <th>Type</th>
                <th>Recipient Number</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var notification in Model.Notifications)
            {
                @if (Model.EditNotificationId == notification.Id.ToString())
                {
                    <tr>
                        <form method="post" enctype="multipart/form-data">
                            <input type="hidden" asp-for="EditNotification.Id" />
                            <td>
                                <input asp-for="EditNotification.Title" class="form-control" />
                            </td>
                            <td>
                                <textarea asp-for="EditNotification.Message" rows="1" class="form-control"></textarea>
                                <input type="file" asp-for="EditNotificationFile" class="form-control mt-1" />
                                @if (!string.IsNullOrEmpty(Model.EditNotification.FilePath))
                                {
                                    <a href="@Model.EditNotification.FilePath" target="_blank">📎 Existing file</a>
                                }
                            </td>
                            <td>
                                <select asp-for="EditNotification.RecipientTypeId" class="form-select">
                                    <option value="">-- Select Type --</option>
                                    @foreach (var type in Model.RecipientTypes)
                                    {
                                        <option value="@type.Id" selected="@(type.Id == Model.EditNotification.RecipientTypeId ? "selected" : null)">
                                            @type.Name
                                        </option>
                                    }
                                </select>
                            </td>
                            <td>
                                <input asp-for="EditNotification.RecipientNumber" class="form-control" />
                            </td>
                            <td>
                                <button type="submit" asp-page-handler="SaveEdit" class="btn btn-sm btn-primary">💾 Save</button>
                                <button type="submit" asp-page-handler="CancelEdit" class="btn btn-sm btn-secondary">❌ Cancel</button>
                            </td>
                        </form>
                    </tr>
                }
                else
                {
                    <tr>
                        <form method="post">
                            <input type="hidden" name="id" value="@notification.Id" />
                            <td>@notification.Title</td>
                            <td>@notification.Message</td>
                            <td>@notification.RecipientTypeName</td>
                            <td>@notification.RecipientNumber</td>
                            <td>
                                <button type="submit" asp-page-handler="Edit" name="id" value="@notification.Id" class="btn btn-sm btn-warning">✏️ Edit</button>
                                @if (!notification.IsDeleted)
                                {
                                    <button type="button" class="btn btn-sm btn-danger" onclick="showDeleteModal('@notification.Id', '@Url.Page("", "", new { handler = "Delete" }, null)')">🗑️ Delete</button>
                                }
                                else
                                {
                                    <button type="submit" asp-page-handler="Activate" name="id" value="@notification.Id" class="btn btn-sm btn-success">♻️ Activate</button>
                                }
                            </td>
                        </form>
                    </tr>
                }
            }
        </tbody>
    </table>

    <!-- Pagination -->
    <nav>
        <ul class="pagination">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="?CurrentPage=@(Model.CurrentPage - 1)&SearchTerm=@Model.SearchTerm">Previous</a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="?CurrentPage=@i&SearchTerm=@Model.SearchTerm">@i</a>
                </li>
            }
            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="?CurrentPage=@(Model.CurrentPage + 1)&SearchTerm=@Model.SearchTerm">Next</a>
            </li>
        </ul>
    </nav>
</div>
