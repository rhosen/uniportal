@page
@model UniPortal.Pages.Academics.Operations.EnrollmentModel
@{
    ViewData["Title"] = "Enrollment Management";
    Layout = "_FacultyLayout";
}

<div class="container my-4">

    <!-- Page Header -->
    <div class="d-flex align-items-center mb-4">
        <svg class="me-2 text-primary" width="40" height="40" fill="currentColor" viewBox="0 0 16 16">
            <path d="M8 0L0 4l8 4 8-4-8-4zm0 5L1 9l7 4 7-4-7-4z" />
            <path d="M1 11v1l7 4 7-4v-1l-7 4-7-4z" />
        </svg>
        <div>
            <h5 class="mb-0 fw-bold">Enrollment Management</h5>
        </div>
    </div>

    <div class="row g-4">

        <!-- Left Panel: Student Info -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4" style="background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%);">
                <div class="card-body">
                    <div class="mb-3">
                        <form method="get">
                            <select name="studentId" class="form-select student-select" onchange="this.form.submit()">
                                <option value="">Select Student</option>
                                @foreach (var s in Model.AllStudents)
                                {
                                    <option value="@s.Id" selected="@(Model.SelectedStudent != null && Model.SelectedStudent.Id == s.Id ? "selected" : null)">
                                        @s.StudentNumber - @s.FullName
                                    </option>
                                }
                            </select>
                        </form>
                    </div>

                    @if (Model.SelectedStudent != null)
                    {
                        <div class="mt-3">
                            <div class="d-flex align-items-center mb-2">
                                <svg class="me-2 text-primary" width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 12c2.7 0 5-2.3 5-5s-2.3-5-5-5-5 2.3-5 5 2.3 5 5 5zm0 2c-3.3 0-10 1.7-10 5v3h20v-3c0-3.3-6.7-5-10-5z" />
                                </svg>
                                <span class="fw-semibold">@Model.SelectedStudent.FullName</span>
                            </div>

                            <div class="d-flex align-items-center mb-2">
                                <svg class="me-2 text-success" width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm-8 3c1.1 0 2 .9 2 2s-.9 2-2 2-2-.9-2-2 .9-2 2-2zm6 9H6v-1c0-1 2-1.5 6-1.5s6 .5 6 1.5v1z" />
                                </svg>
                                <span class="fw-semibold">@Model.SelectedStudent.StudentNumber</span>
                            </div>

                            <div class="d-flex align-items-center mb-2">
                                <svg class="me-2 text-warning" width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M19 2H6c-1.1 0-2 .9-2 2v16l7-3 7 3V4c0-1.1-.9-2-2-2z" />
                                </svg>
                                <span class="fw-semibold">@Model.SelectedStudent.ProgramName</span>
                            </div>

                            <div class="d-flex align-items-center">
                                <svg class="me-2 text-info" width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 18H5V9h14v13z" />
                                </svg>
                                <span class="fw-semibold">@Model.SelectedStudent.CurrentSemesterName</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Panel: Courses -->
        <div class="col-md-9">
            @if (Model.SelectedStudent != null)
            {
                <div class="d-flex justify-content-between align-items-center mb-3 no-print">
                    <!-- Left: Print & PDF Buttons -->
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-secondary" onclick="window.print()">
                            <svg class="me-1" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M2 1a1 1 0 0 0-1 1v4h2V2h10v4h2V2a1 1 0 0 0-1-1H2z" />
                                <path d="M2 7v6h2v3h8v-3h2V7H2z" />
                            </svg>
                            Print
                        </button>
                        <a asp-page-handler="ExportEnrollmentPdfDirect" asp-route-studentId="@Model.SelectedStudent.Id" class="btn btn-outline-secondary">
                            <svg class="me-1" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M4 0h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2z" />
                            </svg>
                            Export PDF
                        </a>
                    </div>

                    <!-- Right: Semester Info -->
                    <div class="text-muted fst-italic small">
                        Academic Semester: @Model.AcademicSemesterName
                    </div>
                </div>


                <!-- Eligible Courses -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white border-bottom d-flex align-items-center">
                        <svg class="me-2 text-success" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-4 4.5a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l1.094 1.093 3.492-3.446z" />
                            <path d="M14 1H2a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1zm0 13H2V2h12v12z" />
                        </svg>
                        <h6 class="mb-0">Available Courses</h6>
                    </div>
                    <div class="card-body p-0">

                        <form method="post" asp-page-handler="Save">

                            <input type="hidden" name="StudentId" value="@Model.SelectedStudent.Id" />

                            <!-- Confirmation Modal -->
                            <div class="modal fade" id="confirmEnrollModal" tabindex="-1" aria-labelledby="confirmEnrollModalLabel" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="confirmEnrollModalLabel">Confirm Changes</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <p>
                                                All <strong>checked courses</strong> will be <span class="text-success">enrolled</span>.<br />
                                                All <strong>unchecked courses</strong> will be <span class="text-danger">removed</span>.
                                            </p>
                                            <p>Do you want to proceed?</p>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-primary">Yes</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <table class="table table-hover table-striped mb-0 align-middle">
                                <thead class="table-light text-muted">
                                    <tr>
                                        <th>Course</th>
                                        <th>Faculty</th>
                                        <th>Credits</th>
                                        <th>Schedule</th>
                                        <th>Seats</th>
                                        <th>Enrolled</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.EligibleCourses.Count; i++)
                                    {
                                        var course = Model.EligibleCourses[i];
                                        <tr>
                                            <td>@course.CourseTitle</td>
                                            <td>@course.FacultyName</td>
                                            <td>@course.CreditHours</td>
                                            <td>@course.Schedule</td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="me-2">@course.CurrentEnrollment / @course.MaxEnrollment</div>
                                                    <div class="progress flex-grow-1" style="height: 8px;">
                                                        <div class="progress-bar" role="progressbar" style="width: @( (double)course.CurrentEnrollment / course.MaxEnrollment * 100 )%">
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                @if (course.IsGraded)
                                                {
                                                    <span class="badge bg-success">Enrolled & Graded</span>
                                                }
                                                else
                                                {
                                                    <div class="form-check form-switch m-0">
                                                        <input type="checkbox" class="form-check-input"
                                                               name="EnrolledCourses" value="@course.Id"
                                                               @(course.IsEnrolled ? "checked" : "") />
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            <div class="p-3">
                                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#confirmEnrollModal">
                                    Save
                                </button>
                            </div>

                        </form>
                    </div>
                </div>

                <!-- Past Enrollments -->
                <div class="accordion" id="pastEnrollments">
                    <h5 class="mb-3 d-flex align-items-center text-muted">
                        <svg class="me-2 text-warning" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M3 0h10a1 1 0 0 1 1 1v14l-8-4-8 4V1a1 1 0 0 1 1-1z" />
                        </svg>
                        Past Enrollments
                    </h5>
                    @foreach (var sem in Model.PastEnrollmentsBySemester)
                    {
                        var semId = "sem" + sem.Key.Replace(" ", "");
                        <div class="accordion-item border-0 mb-2">
                            <h2 class="accordion-header" id="heading@semId">
                                <button class="accordion-button collapsed shadow-sm" style="background-color:#f8f9fa;" type="button" data-bs-toggle="collapse" data-bs-target="#collapse@semId" aria-expanded="false" aria-controls="collapse@semId">
                                    @sem.Key
                                </button>
                            </h2>
                            <div id="collapse@semId" class="accordion-collapse collapse" aria-labelledby="heading@semId" data-bs-parent="#pastEnrollments">
                                <div class="accordion-body p-0">
                                    <table class="table table-sm table-hover mb-0">
                                        <thead>
                                            <tr>
                                                <th>Course</th>
                                                <th>Teacher</th>
                                                <th>Credits</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var course in sem.Value)
                                            {
                                                <tr>
                                                    <td>@course.CourseTitle</td>
                                                    <td>@course.FacultyName</td>
                                                    <td>@course.CreditHours</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Placeholder when no student is selected -->
                <div class="card shadow-sm border-0 p-5 text-center text-muted">
                    <svg class="mb-3" width="48" height="48" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-4 4.5a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l1.094 1.093 3.492-3.446z" />
                        <path d="M14 1H2a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1zm0 13H2V2h12v12z" />
                    </svg>
                    <h5>No student selected</h5>
                    <p>Select a student from the left panel to view eligible courses and past enrollments.</p>
                </div>
            }
        </div>

    </div>
</div>

<style>
    @@media print {
        .no-print, .btn {
            display: none !important;
        }

        body {
            background: white;
            color: black;
            font-size: 12pt;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        .card {
            box-shadow: none !important;
        }
    }

</style>