@page
@model UniPortal.Pages.Academics.Operations.CourseOfferingsModel
@{
    ViewData["Title"] = "Course Offerings Management";
    Layout = Model.LayoutForRole;
}

<div class="container my-4">

    <!-- Page Header -->
    <div class="d-flex align-items-center mb-4">
        <svg class="me-2 text-primary" width="40" height="40" fill="currentColor" viewBox="0 0 16 16">
            <path d="M8 0L0 4l8 4 8-4-8-4zm0 5L1 9l7 4 7-4-7-4z" />
            <path d="M1 11v1l7 4 7-4v-1l-7 4-7-4z" />
        </svg>
        <h5 class="mb-0 fw-bold">Course Offerings Management</h5>
    </div>

    <div class="row g-4">
        <!-- Left Panel: Filters -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4" style="background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%);">
                <div class="card-body">
                    <form method="post" asp-page-handler="Load">

                        <div class="mb-3">
                            <label>Offering Semester</label>
                            <select asp-for="SelectedSemesterId" class="form-select">
                                <option value="">-- Select Semester --</option>
                                @foreach (var s in Model.SemesterOptions)
                                {
                                    <option value="@s.Id" selected="@(Model.SelectedSemesterId == s.Id ? "selected" : null)">
                                        @s.Name
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label>Program</label>
                            <select asp-for="ProgramId" class="form-select">
                                <option value="">Select Program</option>
                                @foreach (var p in Model.Programs)
                                {
                                    <option value="@p.Id" selected="@(Model.ProgramId == p.Id ? "selected" : null)">
                                        @p.Name
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label>Batch</label>
                            <select asp-for="BatchId" class="form-select">
                                <option value="">Select Batch</option>
                                @foreach (var b in Model.Batches)
                                {
                                    <option value="@b.Id" selected="@(Model.BatchId == b.Id ? "selected" : null)">
                                        @b.Name
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label>Section</label>
                            <select asp-for="SectionId" class="form-select">
                                <option value="">Select Section</option>
                                @foreach (var s in Model.Sections)
                                {
                                    <option value="@s.Id" selected="@(Model.SectionId == s.Id ? "selected" : null)">
                                        @s.Name
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label>Semester</label>
                            <select asp-for="SemesterNumber" class="form-select">
                                <option value="">-- Select Semester --</option>
                                @foreach (var s in Model.SemesterNumberOptions)
                                {
                                    <option value="@s.Number" selected="@(Model.SemesterNumber == s.Number ? "selected" : null)">
                                        @s.Name
                                    </option>
                                }
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Load Courses</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Right Panel: Courses -->
        <div class="col-md-9">

            @if (Model.Offerings.Any())
            {
                <form method="post" asp-page-handler="Save">
                    <input type="hidden" asp-for="ProgramId" />
                    <input type="hidden" asp-for="BatchId" />
                    <input type="hidden" asp-for="SectionId" />
                    <input type="hidden" asp-for="SemesterNumber" />
                    <input type="hidden" asp-for="SelectedSemesterId" />

                    <table class="table table-hover table-striped align-middle">
                        <thead class="table-light text-muted">
                            <tr>
                                <th>Course</th>
                                <th>Faculty</th>
                                <th>Room</th>
                                <th>Days</th>
                                <th>Start</th>
                                <th>End</th>
                                <th>Offered</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Offerings.Count; i++)
                            {
                                var o = Model.Offerings[i];
                                <tr>
                                    <input type="hidden" asp-for="Offerings[i].CurriculumId" />

                                    <td>@o.CourseTitle</td>

                                    <td>
                                        <select name="Offerings[@i].FacultyId" class="form-select form-select-sm">
                                            <option value="">Select Faculty</option>
                                            @foreach (var f in Model.Faculties)
                                            {
                                                <option value="@f.Id" selected="@(f.Id == o.FacultyId ? "selected" : null)">
                                                    @f.Name
                                                </option>
                                            }
                                        </select>
                                    </td>

                                    <td>
                                        <select name="Offerings[@i].RoomId" class="form-select form-select-sm">
                                            <option value="">Select Room</option>
                                            @foreach (var r in Model.Rooms)
                                            {
                                                <option value="@r.Id" selected="@(r.Id == o.RoomId ? "selected" : null)">
                                                    @r.Name
                                                </option>
                                            }
                                        </select>
                                    </td>

                                    <td>
                                        <div class="d-flex flex-wrap gap-2">
                                            @for (int j = 0; j < Model.Days.Length; j++)
                                            {
                                                var day = Model.Days[j];
                                                <div class="form-check form-switch m-0">
                                                    <input class="form-check-input" type="checkbox"
                                                           name="@( $"Offerings[{i}].{day}" )"
                                                           value="true"
                                                           @(Model.Offerings[i].GetType().GetProperty(day).GetValue(Model.Offerings[i]) as bool? == true ? "checked" : "")>
                                                    <label class="form-check-label" for="@($"{day}-@i")">@day</label>
                                                </div>
                                            }
                                        </div>
                                    </td>


                                    <td>
                                        <input type="time" name="Offerings[@i].StartTime"
                                               value="@(o.StartTime.ToString("HH\\:mm"))"
                                               class="form-control form-control-sm" />
                                    </td>

                                    <td>
                                        <input type="time" name="Offerings[@i].EndTime"
                                               value="@(o.EndTime.ToString("HH\\:mm"))"
                                               class="form-control form-control-sm" />
                                    </td>

                                    <td>
                                        <div class="form-check form-switch m-0">
                                            <input class="form-check-input" asp-for="Offerings[i].IsOffered" />
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="p-3">
                        <button type="submit" class="btn btn-primary w-100"
                                disabled="@(!Model.IsCurrentSemester)">
                            Save Offerings
                        </button>

                        @if (!Model.IsCurrentSemester)
                        {
                            <p class="text-danger mt-2">
                                You cannot modify offerings for a previous semester.
                            </p>
                        }

                    </div>

                </form>
            }
            else
            {
                <div class="card shadow-sm border-0 p-5 text-center text-muted">
                    <h5>No courses loaded</h5>
                    <p>Select Program, Batch, Section, and Semester, then click "Load Courses".</p>
                </div>
            }
        </div>
    </div>
</div>
