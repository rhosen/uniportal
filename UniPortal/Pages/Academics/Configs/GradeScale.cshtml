@page
@model UniPortal.Pages.Academics.Configs.GradeScaleModel
@{
    ViewData["Title"] = "Grade Scale Management";
    Layout = "_AdminLayout";
}

<div class="container my-4">
    <h2 class="mb-4">📊 Grade Scale Management</h2>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <table class="table table-striped">
        <thead class="table-dark">
            <tr>
                <th>Grade</th>
                <th>Min Marks</th>
                <th>Max Marks</th>
                <th>GPA</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var gs in Model.GradeScales)
            {
                <tr>
                    <form method="post">
                        <input type="hidden" name="id" value="@gs.Id" />

                        @if (Model.EditGradeScaleId == gs.Id.ToString())
                        {
                        <td><input name="EditGradeScale.Grade" value="@Model.EditGradeScale.Grade" class="form-control" required /></td>
                        <td><input name="EditGradeScale.MinMarks" type="number" step="0.01" value="@Model.EditGradeScale.MinMarks" class="form-control" required /></td>
                        <td><input name="EditGradeScale.MaxMarks" type="number" step="0.01" value="@Model.EditGradeScale.MaxMarks" class="form-control" required /></td>
                        <td><input name="EditGradeScale.GPA" type="number" step="0.01" value="@Model.EditGradeScale.GPA" class="form-control" required /></td>
                        <td>
                            <button type="submit" asp-page-handler="SaveEdit" class="btn btn-sm btn-primary">💾 Save</button>
                            <button type="submit" asp-page-handler="CancelEdit" class="btn btn-sm btn-secondary">❌ Cancel</button>
                        </td>
                    }
                    else
                    {
                        <td>@gs.Grade</td>
                        <td>@gs.MinMarks</td>
                        <td>@gs.MaxMarks</td>
                        <td>@gs.GPA</td>
                        <td>
                            <button type="submit" asp-page-handler="Edit" name="id" value="@gs.Id" class="btn btn-sm btn-warning">Edit</button>
                        </td>
                    }
                    </form>
                </tr>
            }
        </tbody>
    </table>
</div>
