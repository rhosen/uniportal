@page
@model UniPortal.Pages.Academics.Configs.RecipientModel
@{
    ViewData["Title"] = "Recipient Management";
    Layout = "_AdminLayout";

    // Toggle read-only mode here
    var isReadOnly = true; // set to false to allow adding/editing/deleting
}

<div class="container my-4">
    <h2 class="mb-4">📩 Recipient Management</h2>

    <!-- Search Box -->
    <form method="get" class="mb-3">
        <div class="input-group">
            <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by name..." />
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
    </form>

    @* Add New Recipient only if not read-only *@
    @if (!isReadOnly)
    {
        <form method="post">
            <table class="table table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>New</td>
                        <td><input asp-for="NewRecipient.Name" class="form-control" required /></td>
                        <td><input asp-for="NewRecipient.Description" class="form-control" /></td>
                    </tr>
                </tbody>
            </table>
        </form>
    }

    <!-- Existing Recipients Table -->
    <table class="table table-striped">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Description</th>
                @if (!isReadOnly)
                {
                    <th>Actions</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var rec in Model.Recipients)
            {
                <tr>
                    <td>@rec.Name</td>
                    <td>@rec.Description</td>
                    @if (!isReadOnly)
                    {
                        <td>
                            <button type="submit" asp-page-handler="Edit" name="id" value="@rec.Id" class="btn btn-sm btn-warning">Edit</button>
                            @if (!rec.IsDeleted)
                            {
                                <button type="button" class="btn btn-sm btn-danger" onclick="showDeleteModal('@rec.Id', '@Url.Page("", "", new { handler = "Delete" }, null)')">Delete</button>
                            }
                            else
                            {
                                <button type="submit" asp-page-handler="Activate" name="id" value="@rec.Id" class="btn btn-sm btn-success">Activate</button>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>

    <!-- Pagination -->
    <nav>
        <ul class="pagination">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="?CurrentPage=@(Model.CurrentPage - 1)&SearchTerm=@Model.SearchTerm">Previous</a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="?CurrentPage=@i&SearchTerm=@Model.SearchTerm">@i</a>
                </li>
            }
            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="?CurrentPage=@(Model.CurrentPage + 1)&SearchTerm=@Model.SearchTerm">Next</a>
            </li>
        </ul>
    </nav>
</div>
