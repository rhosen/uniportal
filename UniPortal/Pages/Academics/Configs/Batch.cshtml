@page
@model UniPortal.Pages.Academics.Configs.BatchModel
@{
    ViewData["Title"] = "Batch Management";
    Layout = "_AdminLayout";
}

<div class="container my-4">
    <h2 class="mb-4">🎓 Batch Management</h2>

    <!-- Search Box -->
    <form method="get" class="mb-3">
        <div class="input-group">
            <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by batch number..." />
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
    </form>

    <!-- Add New Batch -->
    <form method="post">
        <table class="table table-striped">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Batch Number</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>New</td>
                    <td><input asp-for="NewBatch.Number" class="form-control" required /></td>
                    <td>
                        <button type="submit" asp-page-handler="Create" class="btn btn-success btn-sm">Add</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>

    <!-- Existing Batches Table -->
    <table class="table table-striped">
        <thead class="table-dark">
            <tr>
                <th>Batch Number</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var batch in Model.Batches)
            {
                <tr>
                    <form method="post">
                        <input type="hidden" name="id" value="@batch.Id" />
                        <input type="hidden" name="CurrentPage" value="@Model.CurrentPage" />

                        @if (Model.EditBatchId == batch.Id.ToString())
                        {
                            <!-- Editing Row -->
                        <td><input name="EditBatch.Number" value="@Model.EditBatch.Number" class="form-control" /></td>
                        <td>
                            <button type="submit" asp-page-handler="SaveEdit" class="btn btn-sm btn-primary">💾 Save</button>
                            <button type="submit" asp-page-handler="CancelEdit" class="btn btn-sm btn-secondary">❌ Cancel</button>
                        </td>
                    }
                    else
                    {
                        <!-- Normal Row -->
                        <td>@batch.Number</td>
                        <td>
                            <button type="submit" asp-page-handler="Edit" name="id" value="@batch.Id" class="btn btn-sm btn-warning">Edit</button>
                            @if (!batch.IsDeleted)
                            {
                                <button type="button" class="btn btn-sm btn-danger"
                                        onclick="showDeleteModal('@batch.Id', '@Url.Page("", "", new { handler = "Delete" }, null)')">
                                    Delete
                                </button>
                            }
                            else
                            {
                                <button type="submit" asp-page-handler="Activate" name="id" value="@batch.Id" class="btn btn-sm btn-success">Activate</button>
                            }
                        </td>
                    }
                    </form>
                </tr>
            }
        </tbody>
    </table>

    <!-- Pagination -->
    <nav>
        <ul class="pagination">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="?CurrentPage=@(Model.CurrentPage - 1)&SearchTerm=@Model.SearchTerm">Previous</a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="?CurrentPage=@i&SearchTerm=@Model.SearchTerm">@i</a>
                </li>
            }
            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="?CurrentPage=@(Model.CurrentPage + 1)&SearchTerm=@Model.SearchTerm">Next</a>
            </li>
        </ul>
    </nav>
</div>
