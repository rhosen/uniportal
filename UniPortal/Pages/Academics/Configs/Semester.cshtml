@page
@model UniPortal.Pages.Academics.Configs.SemesterModel
@{
    ViewData["Title"] = "Semester Management";
    Layout = "_AdminLayout";
}

<div class="container my-4">
    <h2 class="mb-4">📅 Semester Management</h2>

    <!-- Validation errors -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <!-- Search Box -->
    <form method="get" class="mb-3">
        <div class="input-group">
            <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by semester..." />
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
    </form>

    <!-- Add New Semester -->
    <form method="post">
        <table class="table table-striped">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Semester Type</th>
                    <th>Academic Year</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Current</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>New</td>
                    <td>
                        <select asp-for="NewSemester.SemesterType" class="form-control" required>
                            <option value="">Select Type</option>
                            <option value="Fall" selected="@(Model.NewSemester.SemesterType == "Fall" ? "selected" : null)">Fall</option>
                            <option value="Spring" selected="@(Model.NewSemester.SemesterType == "Spring" ? "selected" : null)">Spring</option>
                            <option value="Summer" selected="@(Model.NewSemester.SemesterType == "Summer" ? "selected" : null)">Summer</option>
                        </select>
                    </td>
                    <td>
                        <input asp-for="NewSemester.AcademicYear" class="form-control" placeholder="e.g., 2025-2026" required />
                    </td>
                    <td><input asp-for="NewSemester.StartDate" type="date" class="form-control" required /></td>
                    <td><input asp-for="NewSemester.EndDate" type="date" class="form-control" required /></td>
                    <td>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="NewSemester.IsCurrent">
                        </div>
                    </td>
                    <td>
                        <button type="submit" asp-page-handler="Create" class="btn btn-success btn-sm">Add</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>

    <!-- Existing Semesters -->
    <table class="table table-striped">
        <thead class="table-dark">
            <tr>
                <th>Semester Type</th>
                <th>Academic Year</th>
                <th>Start</th>
                <th>End</th>
                <th>Current</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sem in Model.Semesters)
            {
                <tr>
                    <form method="post">
                        <input type="hidden" name="id" value="@sem.Id" />

                        @if (Model.EditSemesterId == sem.Id.ToString())
                        {
                            <!-- Editing Row -->
                        <td>
                            <select asp-for="EditSemester.SemesterType" class="form-control" required>
                                <option value="Fall">Fall</option>
                                <option value="Spring">Spring</option>
                                <option value="Summer">Summer</option>
                            </select>
                        </td>
                        <td>
                            <input asp-for="EditSemester.AcademicYear" class="form-control" required />
                        </td>
                        <td><input asp-for="EditSemester.StartDate" type="date" class="form-control" /></td>
                        <td><input asp-for="EditSemester.EndDate" type="date" class="form-control" /></td>
                        <td>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="EditSemester.IsCurrent">
                            </div>
                        </td>
                        <td>
                            <button type="submit" asp-page-handler="SaveEdit" class="btn btn-sm btn-primary">💾 Save</button>
                            <button type="submit" asp-page-handler="CancelEdit" class="btn btn-sm btn-secondary">❌ Cancel</button>
                        </td>
                    }
                    else
                    {
                        <!-- Normal Row -->
                        <td>@sem.SemesterType</td>
                        <td>@sem.AcademicYear</td>
                        <td>@sem.StartDate.ToString("yyyy-MM-dd")</td>
                        <td>@sem.EndDate.ToString("yyyy-MM-dd")</td>
                        <td>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" disabled asp-for="@sem.IsCurrent">
                            </div>
                        </td>
                        <td>
                            <button type="submit" asp-page-handler="Edit" name="id" value="@sem.Id" class="btn btn-sm btn-warning">Edit</button>
                            @if (!sem.IsDeleted)
                            {
                                <button type="button" class="btn btn-sm btn-danger" onclick="showDeleteModal('@sem.Id', '@Url.Page("", "", new { handler = "Delete" }, null)')"> Delete </button>
                            }
                            else
                            {
                                <button type="submit" asp-page-handler="Activate" name="id" value="@sem.Id" class="btn btn-sm btn-success">Activate</button>
                            }
                        </td>
                    }
                    </form>
                </tr>
            }
        </tbody>
    </table>

    <!-- Pagination -->
    <nav>
        <ul class="pagination">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="?CurrentPage=@(Model.CurrentPage - 1)&SearchTerm=@Model.SearchTerm">Previous</a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="?CurrentPage=@i&SearchTerm=@Model.SearchTerm">@i</a>
                </li>
            }
            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="?CurrentPage=@(Model.CurrentPage + 1)&SearchTerm=@Model.SearchTerm">Next</a>
            </li>
        </ul>
    </nav>
</div>
