@page
@model UniPortal.Pages.Portals.InboxModel
@{
    ViewData["Title"] = "Inbox";
    Layout = "_Layout";
}

@functions {
    public string GetRelativeTime(DateTime dateTime)
    {
        var ts = DateTime.Now - dateTime; // local time

        if (ts.TotalSeconds < 60)
            return $"{ts.Seconds} seconds ago";
        if (ts.TotalMinutes < 60)
            return $"{ts.Minutes} minutes ago";
        if (ts.TotalHours < 24)
            return $"{ts.Hours} hours ago";
        if (ts.TotalDays < 2)
            return "Yesterday";
        if (ts.TotalDays < 7)
            return $"{(int)ts.TotalDays} days ago";

        return dateTime.ToString("dd-MMM-yyyy");
    }
}

<div class="container-fluid my-4">
    <div class="row g-0" style="height: 80vh;">

        <!-- Left Panel: Folders / Filters -->
        <div class="col-md-2 border-end bg-light d-flex flex-column">
            <h5 class="p-3 mb-2 border-bottom fw-bold">📬 Inbox</h5>
            <ul class="list-group list-group-flush flex-grow-1 overflow-auto">
                <li class="list-group-item @(Model.Filter == "all" ? "active" : "")">
                    <a asp-page="./Inbox" asp-route-Filter="all" class="text-decoration-none d-block text-dark">All</a>
                </li>
                <li class="list-group-item @(Model.Filter == "unread" ? "active" : "")">
                    <a asp-page="./Inbox" asp-route-Filter="unread" class="text-decoration-none d-block text-dark">Unread</a>
                </li>
                <li class="list-group-item @(Model.Filter == "today" ? "active" : "")">
                    <a asp-page="./Inbox" asp-route-Filter="today" class="text-decoration-none d-block text-dark">Today</a>
                </li>
                <li class="list-group-item @(Model.Filter == "yesterday" ? "active" : "")">
                    <a asp-page="./Inbox" asp-route-Filter="yesterday" class="text-decoration-none d-block text-dark">Yesterday</a>
                </li>
            </ul>
        </div>

        <!-- Middle Panel: Notification List -->
        <div class="col-md-4 border-end d-flex flex-column bg-white">
            <!-- Search Box -->
            <div class="p-3 border-bottom">
                <form method="get" class="d-flex">
                    <input type="text" class="form-control me-2" placeholder="Search notifications..." asp-for="SearchTerm" />
                    <button type="submit" class="btn btn-primary">Search</button>
                </form>
            </div>

            <!-- Notification List -->
            <div class="list-group list-group-flush flex-grow-1 overflow-auto" style="scroll-behavior: smooth;">
                @foreach (var notification in Model.Notifications)
                {
                    <a class="list-group-item list-group-item-action d-flex flex-column @(notification.IsRead ? "" : "fw-bold")"
                       asp-page="./Inbox"
                       asp-route-SelectedNotificationId="@notification.Id"
                       asp-route-Filter="@Model.Filter"
                       asp-route-SearchTerm="@Model.SearchTerm"
                       asp-route-CurrentPage="@Model.CurrentPage">
                        <div class="d-flex justify-content-between align-items-center">
                            <span>@(notification.IsRead ? "📌" : "📩") @notification.Title</span>
                            <small class="text-muted">@GetRelativeTime(notification.CreatedAt)</small>
                        </div>
                    </a>
                }
            </div>

            <!-- Load More -->
            @if (Model.CurrentPage < Model.TotalPages)
            {
                <div class="p-3 text-center border-top">
                    <a class="btn btn-outline-primary" asp-page="./Inbox"
                       asp-route-CurrentPage="@(Model.CurrentPage + 1)"
                       asp-route-Filter="@Model.Filter"
                       asp-route-SearchTerm="@Model.SearchTerm">
                        Load More…
                    </a>
                </div>
            }
        </div>

        <!-- Right Panel: Selected Notification -->
        <div class="col-md-6 d-flex flex-column bg-light">
            <div class="p-3 border-bottom fw-bold">📄 Message Preview</div>
            <div id="selectedMessage" class="p-3 overflow-auto flex-grow-1">
                @if (Model.SelectedNotification != null)
                {
                    <p>@Model.SelectedNotification.Message</p>
                    @if (!string.IsNullOrEmpty(Model.SelectedNotification.FilePath))
                    {
                        @if (!string.IsNullOrEmpty(Model.SelectedNotification.FilePath))
                        {
                            <div class="mt-2">
                                <a href="@Model.SelectedNotification.FilePath" target="_blank" class="text-decoration-none">📎 Attachment</a>
                            </div>
                        }
                    }
                }
                else
                {
                    <p class="text-muted">Select a message to view its content here...</p>
                }
            </div>
        </div>

    </div>
</div>
