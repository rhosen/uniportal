@page
@model UniPortal.Pages.Portals.InboxModel
@{
    ViewData["Title"] = "Inbox";
    Layout = "_Layout";
}

<div class="container-fluid my-4">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-md-3 border-end">
            <h5 class="mb-3">📬 Inbox</h5>
            <ul class="list-group">
                <li class="list-group-item @(Model.Filter == "all" ? "active" : "")">
                    <a asp-page="./Inbox" asp-route-Filter="all">All</a>
                </li>
                <li class="list-group-item @(Model.Filter == "unread" ? "active" : "")">
                    <a asp-page="./Inbox" asp-route-Filter="unread">Unread</a>
                </li>
                <li class="list-group-item @(Model.Filter == "today" ? "active" : "")">
                    <a asp-page="./Inbox" asp-route-Filter="today">Today</a>
                </li>
                <li class="list-group-item @(Model.Filter == "yesterday" ? "active" : "")">
                    <a asp-page="./Inbox" asp-route-Filter="yesterday">Yesterday</a>
                </li>
            </ul>
        </div>

        <!-- Notifications -->
        <div class="col-md-9">
            <form method="get" class="d-flex mb-3">
                <input type="text" class="form-control me-2" placeholder="Search notifications..."
                       asp-for="SearchTerm" />
                <button type="submit" class="btn btn-primary">Search</button>
            </form>

            <div class="list-group">
                @foreach (var notification in Model.Notifications)
                {
                    <a class="list-group-item list-group-item-action @(notification.IsRead ? "" : "fw-bold")"
                       asp-page-handler="Read"
                       asp-route-id="@notification.Id"
                       target="_blank">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span>📌 @notification.Title</span>
                                @if (!notification.IsRead)
                                {
                                    <span class="badge bg-danger ms-2">NEW</span>
                                }
                            </div>
                            <small class="text-muted">@notification.CreatedAt.ToString("dd-MMM-yyyy")</small>
                        </div>
                        <div class="mt-1">@notification.Message</div>
                        @if (!string.IsNullOrEmpty(notification.FilePath))
                        {
                            <div class="mt-1"><span>📎 Attachment</span></div>
                        }
                    </a>
                }
            </div>

            <!-- Load More -->
            @if (Model.CurrentPage < Model.TotalPages)
            {
                <div class="mt-3 text-center">
                    <a class="btn btn-outline-primary" asp-page="./Inbox"
                       asp-route-CurrentPage="@(Model.CurrentPage + 1)"
                       asp-route-Filter="@Model.Filter"
                       asp-route-SearchTerm="@Model.SearchTerm">
                        Load More…
                    </a>
                </div>
            }
        </div>
    </div>
</div>
