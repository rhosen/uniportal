@page
@model UniPortal.Pages.Portals.StudentClassworkModel
@{
    ViewData["Title"] = "Coursework";
    Layout = Model.LayoutForRole;
}

<div class="container-fluid my-4">
    <div class="row g-0" style="height: 80vh;">

        <!-- LEFT PANEL: Semester & Course Dropdown -->
        <div class="col-md-2 border-end bg-light d-flex flex-column">
            <h5 class="p-3 mb-2 border-bottom fw-bold">📚 Courses</h5>
            <form method="get" class="p-3">
                <!-- Semester Dropdown -->
                <select class="form-select form-select-sm mb-2" name="SelectedSemesterId" onchange="this.form.submit()">
                    <option value="">Select Semester</option>
                    @foreach (var s in Model.SemesterOptions)
                    {
                        <option value="@s.Id" selected="@(Model.SelectedSemesterId == s.Id ? "selected" : null)">
                            @s.Name
                        </option>
                    }
                </select>

                <!-- Course Dropdown -->
                @if (Model.CourseOptions.Any())
                {
                    <select class="form-select form-select-sm" name="SelectedCourseOfferingId" onchange="this.form.submit()">
                        <option value="">Select Course</option>
                        @foreach (var c in Model.CourseOptions)
                        {
                            <option value="@c.Id" selected="@(Model.SelectedCourseOfferingId == c.Id ? "selected" : null)">
                                @c.Name
                            </option>
                        }
                    </select>
                }
            </form>
        </div>

        <!-- MIDDLE PANEL: Classwork List -->
        <div class="col-md-4 border-end d-flex flex-column bg-white">
            <!-- Search Box -->
            <div class="p-3 border-bottom">
                <form method="get" class="d-flex">
                    <input type="hidden" name="SelectedSemesterId" value="@Model.SelectedSemesterId" />
                    <input type="hidden" name="SelectedCourseOfferingId" value="@Model.SelectedCourseOfferingId" />
                    <input type="text" class="form-control me-2" name="SearchTerm" value="@Model.SearchTerm" placeholder="Search coursework..." />
                    <button type="submit" class="btn btn-primary">Search</button>
                </form>
            </div>

            <!-- Coursework List -->
            <div class="list-group list-group-flush flex-grow-1 overflow-auto">
                @foreach (var cw in Model.Classworks)
                {
                    <a class="list-group-item list-group-item-action d-flex flex-column @(cw.HasSubmitted ? "" : "fw-bold")"
                       asp-page="./StudentClasswork"
                       asp-route-SelectedClassworkId="@cw.Id"
                       asp-route-SelectedSemesterId="@Model.SelectedSemesterId"
                       asp-route-SelectedCourseOfferingId="@Model.SelectedCourseOfferingId"
                       asp-route-SearchTerm="@Model.SearchTerm"
                       asp-route-CurrentPage="@Model.CurrentPage">
                        <div class="d-flex justify-content-between align-items-center">
                            <span>@(cw.RequiresSubmission ? "📝" : "📄") @cw.Title</span>
                            <small class="text-muted">@cw.UploadedAt?.ToString("dd-MMM-yyyy")</small>
                        </div>
                        @if (cw.DueDate.HasValue)
                        {
                            <small class="text-muted">Due: @cw.DueDate?.ToString("dd-MMM-yyyy")</small>
                        }
                    </a>
                }
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center p-2 border-top">
                    <a class="btn btn-outline-secondary btn-sm @(Model.CurrentPage == 1 ? "disabled" : "")"
                       asp-page="./StudentClasswork"
                       asp-route-CurrentPage="@(Model.CurrentPage - 1)"
                       asp-route-SelectedSemesterId="@Model.SelectedSemesterId"
                       asp-route-SelectedCourseOfferingId="@Model.SelectedCourseOfferingId"
                       asp-route-SearchTerm="@Model.SearchTerm">
                        ← Previous
                    </a>

                    <small class="text-muted">
                        Page @Model.CurrentPage of @Model.TotalPages
                    </small>

                    <a class="btn btn-outline-secondary btn-sm @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")"
                       asp-page="./StudentClasswork"
                       asp-route-CurrentPage="@(Model.CurrentPage + 1)"
                       asp-route-SelectedSemesterId="@Model.SelectedSemesterId"
                       asp-route-SelectedCourseOfferingId="@Model.SelectedCourseOfferingId"
                       asp-route-SearchTerm="@Model.SearchTerm">
                        Next →
                    </a>
                </div>
            }
        </div>

        <!-- RIGHT PANEL: Coursework Details -->
        <div class="col-md-6 d-flex flex-column bg-light">
            <div class="p-3 border-bottom fw-bold">📄 Coursework Details</div>
            <div id="selectedMessage" class="p-3 overflow-auto flex-grow-1">
                @if (Model.SelectedClasswork != null)
                {
                    <h5>@Model.SelectedClasswork.Title</h5>
                    <p>@Model.SelectedClasswork.Description</p>
                    @if (!string.IsNullOrEmpty(Model.SelectedClasswork.FilePath))
                    {
                        <div class="mb-2">
                            <strong>Attachment:</strong>
                            <a href="@Model.SelectedClasswork.FilePath" target="_blank">📎 View File</a>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.SelectedClasswork.SubmittedFilePath))
                    {
                        <div class="mb-2">
                            <strong>Your Submission:</strong>
                            <a href="@Model.SelectedClasswork.SubmittedFilePath" target="_blank">📎 View File</a>
                            <div><small>@Model.SelectedClasswork.Remarks</small></div>
                            <div><small>Submitted: @Model.SelectedClasswork.SubmittedAt?.ToString("dd-MMM-yyyy hh:mm tt")</small></div>
                        </div>
                    }

                    @if (Model.SelectedClasswork.RequiresSubmission)
                    {
                        <form method="post" enctype="multipart/form-data" asp-page-handler="Submit" class="mt-3" novalidate>
                            <input type="hidden" name="SelectedClassworkId" value="@Model.SelectedClasswork.Id" />
                            <input type="hidden" name="SelectedSemesterId" value="@Model.SelectedSemesterId" />
                            <input type="hidden" name="SelectedCourseOfferingId" value="@Model.SelectedCourseOfferingId" />

                            <div class="mb-2">
                                <label class="form-label">Upload File</label>
                                <input type="file" class="form-control" asp-for="UploadFile" required />
                            </div>

                            <div class="mb-2">
                                <label class="form-label">Remarks</label>
                                <textarea class="form-control" asp-for="Remarks"></textarea>
                            </div>

                            <button type="submit" class="btn btn-success btn-sm">Submit</button>

                            @if (Model.SelectedClasswork.HasSubmitted)
                            {
                                <button type="submit" class="btn btn-danger btn-sm ms-2" formaction="?handler=Delete">Delete Submission</button>
                            }
                        </form>
                    }
                }
                else
                {
                    <p class="text-muted">Select a coursework to view its details here...</p>
                }
            </div>
        </div>
    </div>
</div>
