@page
@model UniPortal.Pages.Portals.AttendanceModel
@{
    ViewData["Title"] = "Attendance";
    Layout = Model.LayoutForRole;
}

<div class="container-fluid my-4">
    <div class="row g-0" style="height: 80vh;">

        <!-- LEFT PANEL: Filters + Search (GET form) -->
        <div class="col-md-3 border-end bg-light d-flex flex-column p-3">
            <h5 class="mb-3 fw-bold">📅 Filters</h5>

            <form method="get">
                <!-- Semester -->
                <div class="mb-2">
                    <label class="form-label">Semester</label>
                    <select class="form-select form-select-sm" name="SelectedSemesterId" onchange="this.form.submit()">
                        <option value="">Select Semester</option>
                        @foreach (var s in Model.SemesterOptions)
                        {
                            <option value="@s.Id" selected="@(Model.SelectedSemesterId == s.Id ? "selected" : null)">
                                @s.Name
                            </option>
                        }
                    </select>
                </div>

                <!-- Batch -->
                <div class="mb-2">
                    <label class="form-label">Batch</label>
                    <select class="form-select form-select-sm" name="SelectedBatchId" onchange="this.form.submit()">
                        <option value="">Select Batch</option>
                        @foreach (var b in Model.BatchOptions)
                        {
                            <option value="@b.Id" selected="@(Model.SelectedBatchId == b.Id ? "selected" : null)">
                                @b.Name
                            </option>
                        }
                    </select>
                </div>

                <!-- Section -->
                <div class="mb-2">
                    <label class="form-label">Section</label>
                    <select class="form-select form-select-sm" name="SelectedSectionId" onchange="this.form.submit()">
                        <option value="">Select Section</option>
                        @foreach (var sec in Model.SectionOptions)
                        {
                            <option value="@sec.Id" selected="@(Model.SelectedSectionId == sec.Id ? "selected" : null)">
                                @sec.Name
                            </option>
                        }
                    </select>
                </div>

                <!-- Course -->
                <div class="mb-2">
                    <label class="form-label">Course</label>
                    <select class="form-select form-select-sm" name="SelectedCourseOfferingId" onchange="this.form.submit()">
                        <option value="">Select Course</option>
                        @foreach (var c in Model.CourseOptions)
                        {
                            <option value="@c.Id" selected="@(Model.SelectedCourseOfferingId == c.Id ? "selected" : null)">
                                @c.Name
                            </option>
                        }
                    </select>
                </div>

                <!-- Date -->
                <div class="mb-2">
                    <label class="form-label">Date</label>
                    <input type="date" class="form-control form-control-sm" name="SelectedDate"
                           value="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                           onchange="this.form.submit()" />
                </div>

                <!-- Search -->
                <div class="mb-3">
                    <label class="form-label">Search Student</label>
                    <input type="text" class="form-control form-control-sm" name="StudentSearchTerm"
                           value="@Model.StudentSearchTerm" placeholder="Search student..." />
                </div>
            </form>
        </div>

        <!-- RIGHT PANEL: Attendance Table (POST form) -->
        <div class="col-md-9 d-flex flex-column bg-white p-3">
            <h5 class="mb-3 fw-bold">📝 Attendance</h5>

            <form method="post">
                <input type="hidden" name="SelectedSemesterId" value="@Model.SelectedSemesterId" />
                <input type="hidden" name="SelectedBatchId" value="@Model.SelectedBatchId" />
                <input type="hidden" name="SelectedSectionId" value="@Model.SelectedSectionId" />
                <input type="hidden" name="SelectedCourseOfferingId" value="@Model.SelectedCourseOfferingId" />
                <input type="hidden" name="SelectedDate" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />

                @if (Model.AttendanceView != null)
                {
                    var disableInputs = Model.AttendanceView.IsCanceled || Model.SelectedDate < DateTime.Today;

                    <!-- Canceled class warning -->
                    @if (Model.AttendanceView.IsCanceled)
                    {
                        <div class="alert alert-warning">
                            ⚠️ This class has been canceled. Reason: @Model.AttendanceView.CancellationReason
                        </div>
                    }

                    <!-- MARK ALL BUTTONS -->
                    <div class="mt-2 mb-2 d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-success" onclick="markAll('Present')" @(disableInputs ? "disabled" : null)>Mark All Present</button>
                        <button type="button" class="btn btn-sm btn-danger" onclick="markAll('Absent')" @(disableInputs ? "disabled" : null)>Mark All Absent</button>
                        <button type="button" class="btn btn-sm btn-warning" onclick="markAll('Late')" @(disableInputs ? "disabled" : null)>Mark All Late</button>
                    </div>

                    <div class="table-responsive flex-grow-1">
                        <table class="table table-striped table-hover align-middle">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>#</th>
                                    <th>Student Name</th>
                                    <th>Status</th>
                                    <th>Remarks</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var student in Model.FilteredStudents)
                                {
                                    <tr>
                                        <td>@(@Model.FilteredStudents.IndexOf(student) + 1)</td>
                                        <td>@student.StudentName</td>
                                        <td>
                                            <div class="d-flex gap-2">
                                                @foreach (var status in new[] { "Present", "Absent", "Late" })
                                                {
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="radio"
                                                               name="Status_@student.StudentId"
                                                               value="@status"
                                                               @(student.Status == status ? "checked" : null)
                                                               @(disableInputs ? "disabled" : null) />
                                                        <label class="form-check-label">@status.Substring(0, 1)</label>
                                                    </div>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm"
                                                   name="Remarks_@student.StudentId"
                                                   value="@student.Remarks"
                                                   @(disableInputs ? "disabled" : null) />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-3 d-flex justify-content-end">
                        <button type="submit"
                                class="btn btn-success"
                                formaction="/Portals/Attendance?handler=SaveAttendance"
                                @(disableInputs ? "disabled" : null)>
                            Save Attendance
                        </button>
                    </div>
                }
                else
                {
                    <p class="text-muted">Select course and date to load attendance.</p>
                }
            </form>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function markAll(status) {
            const radios = document.querySelectorAll('input[type="radio"]:not(:disabled)');
            radios.forEach(radio => {
                if (radio.value === status) {
                    radio.checked = true;
                    const label = radio.nextElementSibling;
                    if (label) label.classList.add("fw-bold");
                } else {
                    const label = radio.nextElementSibling;
                    if (label) label.classList.remove("fw-bold");
                }
            });
        }
    </script>
}
