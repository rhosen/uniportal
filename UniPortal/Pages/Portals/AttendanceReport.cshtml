@page
@model UniPortal.Pages.Portals.AttendanceReportModel
@{
    ViewData["Title"] = "Attendance Report";
    Layout = Model.LayoutForRole;
}

<div class="container-fluid my-4">
    <div class="row g-0">

        <!-- LEFT PANEL: Filters -->
        <div class="col-md-3 border-end bg-light d-flex flex-column p-3">
            <h5 class="mb-3 fw-bold">📅 Filters</h5>

            <form method="get">
                <div class="mb-2">
                    <label class="form-label">Semester</label>
                    <select class="form-select form-select-sm" name="SelectedSemesterId" onchange="this.form.submit()">
                        <option value="">Select Semester</option>
                        @foreach (var s in Model.SemesterOptions)
                        {
                            <option value="@s.Id" selected="@(Model.SelectedSemesterId == s.Id ? "selected" : null)">
                                @s.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="mb-2">
                    <label class="form-label">Course</label>
                    <select class="form-select form-select-sm" name="SelectedCourseOfferingId" onchange="this.form.submit()">
                        <option value="">Select Course</option>
                        @foreach (var c in Model.CourseOptions)
                        {
                            <option value="@c.Id" selected="@(Model.SelectedCourseOfferingId == c.Id ? "selected" : null)">
                                @c.Name
                            </option>
                        }
                    </select>
                </div>
            </form>
        </div>

        <!-- RIGHT PANEL: Attendance Table -->
        <div class="col-md-9 d-flex flex-column bg-white p-3">
            <h5 class="mb-3 fw-bold">📝 Attendance Report</h5>

            @if (Model.AttendanceRecords != null && Model.AttendanceRecords.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th>#</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var record in Model.AttendanceRecords)
                            {
                                <tr class="@(record.IsCanceled ? "table-secondary" : "")">
                                    <td>@(@Model.AttendanceRecords.IndexOf(record) + 1)</td>
                                    <td>@record.Date.ToShortDateString()</td>
                                    <td>@record.Status</td>
                                    <td>@(record.IsCanceled? record.CancellationReason ?? "Class canceled" : record.Remarks)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted">Select semester and course to view your attendance.</p>
            }
        </div>

    </div>
</div>
