@page
@model UniPortal.Pages.Students.OnboardModel
@{
    ViewData["Title"] = "Assign ID";
    Layout = "_AdminLayout";
}

<div class="container my-4">
    <h2 class="mb-4">🧑‍🎓 Onboard Student</h2>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form method="get" class="mb-3">
        <div class="input-group">
            <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by name or email..." />
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
    </form>

    @if (!Model.Students.Any())
    {
        <p class="text-muted">No new students found for onboarding.</p>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Email</th>
                    <th>Registered</th>
                    <th>ID</th>
                    <th>Student ID</th>
                    <th>Batch Number</th>
                    <th>Section</th>
                    <th>Program</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var student in Model.Students)
                {
                    <tr>
                        <form method="post">
                            <input type="hidden" name="Student.AccountId" value="@student.AccountId" />
                        <td>@student.Email</td>
                        <td>@student.CreatedAt.ToString("yyyy-MM-dd")</td>

                        <td>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input use-system-radio" type="radio"
                                       name="Student.UseSystemId" value="true" checked>
                                <label class="form-check-label">System</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input use-system-radio" type="radio"
                                       name="Student.UseSystemId" value="false">
                                <label class="form-check-label">Manual</label>
                            </div>
                        </td>

                        <td>
                            <input type="text" name="Student.StudentId" class="form-control student-id-input"
                                   placeholder="Enter ID..." readonly />
                        </td>

                        <td>
                            <input type="text" name="Student.BatchNumber" class="form-control" placeholder="Batch Number" />
                        </td>

                        <td>
                            <input type="text" name="Student.Section" class="form-control" placeholder="Section" />
                        </td>

                        <td>
                            <select name="Student.ProgramId" class="form-select">
                                <option value="">Program</option>
                                @foreach (var program in Model.Programs)
                                {
                                    <option value="@program.Id">@program.Code</option>
                                }
                            </select>
                        </td>

                        <td>
                            <button type="submit" class="btn btn-sm btn-primary">Onboard</button>
                        </td>
                        </form>
                    </tr>
                }
            </tbody>
        </table>

        <nav>
            <ul class="pagination">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="?CurrentPage=@(Model.CurrentPage - 1)&SearchTerm=@Model.SearchTerm">Previous</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="?CurrentPage=@i&SearchTerm=@Model.SearchTerm">@i</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="?CurrentPage=@(Model.CurrentPage + 1)&SearchTerm=@Model.SearchTerm">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll('input.use-system-radio').forEach(radio => {
            radio.addEventListener('change', () => {
                const row = radio.closest('tr');
                if (!row) return;
                const studentIdInput = row.querySelector('.student-id-input');
                if (!studentIdInput) return;
                if (radio.value === 'true') {
                    studentIdInput.readOnly = true;
                    studentIdInput.value = '';
                } else {
                    studentIdInput.readOnly = false;
                    studentIdInput.focus();
                }
            });
        });
    </script>
}
